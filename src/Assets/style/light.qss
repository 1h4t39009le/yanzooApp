/* ============================================================
   YanZoo — светлая тема
   ------------------------------------------------------------
   Тема не привязана к именам объектов (#loginFrame и т.п.).
   Стилизуются только типы виджетов и их роли через свойства:

     QFrame[card="true"]      — карточка / поверхность
     QFrame[avatar="true"]    — подложка аватара
     QFrame[banner="true"]    — информационный баннер
     QFrame[divider="true"]   — разделитель

     QPushButton[accent="true"] — акцентная кнопка

     QLabel[role="title"]       — заголовок
     QLabel[role="section"]     — заголовок раздела
     QLabel[role="subtitle"]    — подзаголовок
     QLabel[role="caption"]     — подпись
     QLabel[role="secondary"]   — второстепенный текст
     QLabel[role="accent"]      — акцентный текст
     QLabel[role="accentValue"] — акцентное значение
     QLabel[role="avatar"]      — текст аватара
   ============================================================ */

/* Палитра:
   фон             #f3f3f3
   поверхность     #ffffff
   поверхность 2   #eeeeee
   граница         #cccccc
   текст           #000000
   текст 2         #555555
   акцент          #005fb8
*/

/* ---------- Глобальные параметры ---------- */
QWidget {
    color: #000000;
    font-family: "Roboto", "Segoe UI", sans-serif;
}

/* ---------- Фон окон и страниц ---------- */
QMainWindow,
QDialog {
    background-color: #f3f3f3;
}

/* ---------- Текстовые роли ---------- */
QLabel {
    background-color: transparent;
}

QLabel[role="title"],
QLabel[role="section"] {
    color: #000000;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="secondary"] {
    color: #555555;
}

QLabel[role="accent"],
QLabel[role="accentValue"],
QLabel[role="avatar"] {
    color: #005fb8;
}

/* ---------- Карточки, баннеры, разделители ---------- */
QFrame[card="true"] {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 12px;
}

QFrame[avatar="true"] {
    background-color: #eeeeee;
    border: 1px solid #cccccc;
    border-radius: 18px;
}

QFrame[banner="true"] {
    background-color: #e6f0fa;
    border: 1px solid #005fb8;
    border-radius: 6px;
}

QFrame[divider="true"] {
    background-color: #cccccc;
    border: none;
}

/* ---------- Поля ввода и текстовые области ---------- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #005fb8;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #005fb8;
}

/* ---------- Кнопки ---------- */
QPushButton {
    background-color: #eeeeee;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 10px 20px;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QPushButton:pressed,
QPushButton:checked,
QPushButton[accent="true"] {
    background-color: #005fb8;
    border-color: #005fb8;
    color: #ffffff;
}

QPushButton[accent="true"]:hover {
    background-color: #0070d8;
    border-color: #0070d8;
}

QPushButton[accent="true"]:pressed {
    background-color: #004a91;
    border-color: #004a91;
}

QPushButton:disabled {
    background-color: #eeeeee;
    border-color: #cccccc;
    color: #999999;
}

/* ---------- Списки ---------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget::item {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #e0e0e0;
    border: 2px solid #005fb8;
}

QListWidget::item:selected {
    background-color: #005fb8;
    border: 2px solid #005fb8;
    color: #ffffff;
}

/* ---------- Прокручиваемые области ---------- */
QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Полосы прокрутки ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:horizontal {
    background-color: #cccccc;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #005fb8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: transparent;
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Системные элементы ---------- */
QStatusBar {
    background-color: #eeeeee;
    color: #000000;
    border-top: 1px solid #cccccc;
}

QToolTip {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #cccccc;
    padding: 4px;
}
