/* ============================================================
   YanZoo — светлая тема

   Палитра:
     фон окна          #e7ecf3 → #fbfcfe
     поверхность       #ffffff → #f7f9fc
     поле ввода        #ffffff
     граница           #cbd5e1 / #d8e0ea
     текст             #1f2937
     текст вторичный   #64748b
     акцент            #0284c7 / #0369a1
   ============================================================ */

/* ---------- База ---------- */
QWidget {
    color: #1f2937;
    font-family: "Roboto", "Segoe UI", sans-serif;
}

QMainWindow,
QDialog {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 #fbfcfe,
        stop: 1 #e7ecf3
    );
}

/* ---------- Текст ---------- */
QLabel {
    background: transparent;
}

QLabel[role="title"],
QLabel[role="section"] {
    color: #0f172a;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="secondary"] {
    color: #64748b;
}

QLabel[role="accent"],
QLabel[role="accentValue"],
QLabel[role="avatar"] {
    color: #0369a1;
}

/* ---------- Карточки, аватары, баннеры, разделители ---------- */
QFrame[card="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #ffffff,
        stop: 1 #f7f9fc
    );
    border: 1px solid #d8e0ea;
    border-radius: 14px;
}

QFrame[avatar="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8fafc,
        stop: 1 #e2e8f0
    );
    border: 1px solid #cbd5e1;
    border-radius: 18px;
}

QFrame[banner="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #e0f2fe,
        stop: 1 #bae6fd
    );
    border: 1px solid #7dd3fc;
    border-radius: 8px;
}

QFrame[banner="true"] QLabel {
    color: #075985;
}

QFrame[banner="true"] QLabel[role="title"],
QFrame[banner="true"] QLabel[role="section"] {
    color: #082f49;
}

QFrame[banner="true"] QLabel[role="subtitle"],
QFrame[banner="true"] QLabel[role="caption"],
QFrame[banner="true"] QLabel[role="secondary"] {
    color: #0c4a6e;
}

QFrame[divider="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 transparent,
        stop: 0.5 #cbd5e1,
        stop: 1 transparent
    );
    border: none;
}

/* ---------- Поля ввода ---------- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    placeholder-text-color: #94a3b8;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #0284c7;
}

/* ---------- Кнопки ---------- */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff,
        stop: 1 #eef2f7
    );
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 10px 20px;
}

QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8fafc,
        stop: 1 #e2e8f0
    );
    border-color: #94a3b8;
}

QPushButton:pressed {
    background: #dbe3ec;
    border-color: #64748b;
}

QPushButton:disabled {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}

QPushButton[accent="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0ea5e9,
        stop: 1 #0284c7
    );
    color: #ffffff;
    border: 1px solid #0284c7;
}

QPushButton[accent="true"]:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #38bdf8,
        stop: 1 #0ea5e9
    );
    border-color: #0ea5e9;
}

QPushButton[accent="true"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0369a1,
        stop: 1 #075985
    );
    border-color: #0369a1;
}

QPushButton[iconName="arrow-left"] {
    qproperty-icon: url(:/icons/light/arrow-left);
    qproperty-iconSize: 16px 16px;
}

QPushButton[iconName="sun"] {
    qproperty-icon: url(:/icons/light/sun);
    qproperty-iconSize: 16px 16px;
}

QPushButton[iconName="settings-sliders"] {
    qproperty-icon: url(:/icons/light/settings-sliders);
    qproperty-iconSize: 16px 16px;
}

QPushButton[iconName="angle-right"] {
    qproperty-icon: url(:/icons/light/angle-right);
    qproperty-iconSize: 16px 16px;
}

/* ---------- Иконки в карточках списка ---------- */
QLabel[role="icon"] {
    qproperty-scaledContents: true;
}

QLabel[iconName="angle-right"] {
    qproperty-pixmap: url(:/icons/light/angle-right);
}

/* ---------- Списки ---------- */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget::item {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #ffffff,
        stop: 1 #f8fafc
    );
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-bottom: 4px;
}

QListWidget::item:hover {
    background: #f1f5f9;
    border-color: #0284c7;
}

QListWidget::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0284c7,
        stop: 1 #0369a1
    );
    color: #ffffff;
    border-color: #0284c7;
}

/* ---------- Прокрутка ---------- */
QScrollArea,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #cbd5e1,
        stop: 1 #b6c2d1
    );
    border-radius: 4px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #94a3b8,
        stop: 1 #64748b
    );
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    width: 0;
    height: 0;
}

/* ---------- Системные элементы ---------- */
QStatusBar {
    background: #f1f5f9;
    color: #64748b;
    border-top: 1px solid #dbe3ec;
}

QToolTip {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px;
}
