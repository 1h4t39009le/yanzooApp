/* ============================================================
   YanZoo — тёмная тема
   ------------------------------------------------------------
   Тема не привязана к именам объектов (#loginFrame и т.п.).
   Стилизуются только типы виджетов и их роли через свойства:

     QFrame[card="true"]      — карточка / поверхность
     QFrame[avatar="true"]    — подложка аватара
     QFrame[banner="true"]    — информационный баннер
     QFrame[divider="true"]   — разделитель

     QPushButton[accent="true"] — акцентная кнопка

     QLabel[role="title"]       — заголовок
     QLabel[role="section"]     — заголовок раздела
     QLabel[role="subtitle"]    — подзаголовок
     QLabel[role="caption"]     — подпись
     QLabel[role="secondary"]   — второстепенный текст
     QLabel[role="accent"]      — акцентный текст
     QLabel[role="accentValue"] — акцентное значение
     QLabel[role="avatar"]      — текст аватара
   ============================================================ */

/* Палитра:
   фон             #1e1e1e
   поверхность     #252526
   поверхность 2   #333337
   граница         #3f3f46
   текст           #ffffff
   текст 2         #cccccc
   акцент          #007acc
*/

/* ---------- Глобальные параметры ---------- */
QWidget {
    color: #ffffff;
    font-family: "Roboto", "Segoe UI", sans-serif;
}

/* ---------- Фон окон и страниц ---------- */
QMainWindow,
QDialog {
    background-color: #1e1e1e;
}

/* ---------- Текстовые роли ---------- */
QLabel {
    background-color: transparent;
}

QLabel[role="title"],
QLabel[role="section"] {
    color: #ffffff;
}

QLabel[role="subtitle"],
QLabel[role="caption"],
QLabel[role="secondary"] {
    color: #cccccc;
}

QLabel[role="accent"],
QLabel[role="accentValue"],
QLabel[role="avatar"] {
    color: #4da3e0;
}

/* ---------- Карточки, баннеры, разделители ---------- */
QFrame[card="true"] {
    background-color: #252526;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QFrame[avatar="true"] {
    background-color: #333337;
    border: 1px solid #3f3f46;
    border-radius: 18px;
}

QFrame[banner="true"] {
    background-color: #102b3f;
    border: 1px solid #007acc;
    border-radius: 6px;
}

QFrame[divider="true"] {
    background-color: #3f3f46;
    border: none;
}

/* ---------- Поля ввода и текстовые области ---------- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #007acc;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #007acc;
}

/* ---------- Кнопки ---------- */
QPushButton {
    background-color: #333337;
    color: #ffffff;
    border: 1px solid #434346;
    border-radius: 4px;
    padding: 10px 20px;
}

QPushButton:hover {
    background-color: #3f3f46;
}

QPushButton:pressed,
QPushButton:checked,
QPushButton[accent="true"] {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

QPushButton[accent="true"]:hover {
    background-color: #1a8ad9;
    border-color: #1a8ad9;
}

QPushButton[accent="true"]:pressed {
    background-color: #005a99;
    border-color: #005a99;
}

QPushButton:disabled {
    background-color: #2a2a2d;
    border-color: #3f3f46;
    color: #777777;
}

/* ---------- Списки ---------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget::item {
    background-color: #252526;
    border: 1px solid #3f3f46;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #3f3f46;
    border: 2px solid #007acc;
}

QListWidget::item:selected {
    background-color: #007acc;
    border: 2px solid #007acc;
    color: #ffffff;
}

/* ---------- Прокручиваемые области ---------- */
QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Полосы прокрутки ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:horizontal {
    background-color: #3f3f46;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #007acc;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: transparent;
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Системные элементы ---------- */
QStatusBar {
    background-color: #252526;
    color: #cccccc;
    border-top: 1px solid #3f3f46;
}

QToolTip {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #3f3f46;
    padding: 4px;
}
